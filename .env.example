# Supabase (hanya dipakai di server)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# PIN login inspektor (angka)
INSPECTOR_PIN=123456

# String acak panjang untuk menandatangani cookie sesi (mis. `openssl rand -base64 32`)
SESSION_SECRET=

# Zona waktu untuk tampilan tanggal
NEXT_PUBLIC_APP_TIMEZONE=Asia/Jakarta
